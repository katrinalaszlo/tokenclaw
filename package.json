  "description": "Per-key budget caps for AI agents. Local proxy enforces hard spend limits on API keys. Scans your tools, tracks costs, blocks when over budget.",
  "type": "module",
  "keywords": [
    "ai",
    "cost",
    "spend",
    "claude",
    "openai",
    "agents",
    "monitoring",
    "alerts",
    "proxy",
    "budget",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/katrinalaszlo/tokenclaw"
  },
  "bin": {
    "tokenclaw": "./bin/tokenclaw.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts"
  },
  "author": "Kat Laszlo",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "open": "^10.1.0",
    "yaml": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
